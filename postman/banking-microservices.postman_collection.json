            "url": "{{baseUrlClientes}}/api/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Jose Lema\",\n  \"genero\": \"MASCULINO\",\n  \"edad\": 35,\n  \"identificacion\": \"1710034065\",\n  \"direccion\": \"Otavalo sn y principal\",\n  \"telefono\": \"098254785\",\n  \"contrasena\": \"1234\",\n  \"estado\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "",
                  "var json = pm.response.json();",
                  "pm.test('Devuelve clienteId y no expone la contraseña', function () {",
                  "    pm.expect(json.clienteId).to.be.a('string');",
                  "    pm.expect(json).to.not.have.property('contrasena');",
                  "    pm.expect(json.nombre).to.eql('Jose Lema');",
                  "});",
                  "pm.collectionVariables.set('joseId', json.clienteId);"
                ]
              }
            }
          ]
