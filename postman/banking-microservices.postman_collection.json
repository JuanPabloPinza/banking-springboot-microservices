    {
      "name": "04 Reportes (caso 5)",
      "item": [
        {
          "name": "Estado de cuenta de Marianela Montalvo",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrlCuentas}}/api/reportes?cliente={{marianelaId}}&fecha={{fechaDesde}},{{fechaHasta}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function iso(d) {",
                  "    return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);",
                  "}",
                  "var hoy = new Date();",
                  "pm.collectionVariables.set('fechaDesde', iso(new Date(hoy.getTime() - 86400000)));",
                  "pm.collectionVariables.set('fechaHasta', iso(new Date(hoy.getTime() + 86400000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "var json = pm.response.json();",
                  "function cuenta(numero) { return json.cuentas.filter(function (c) { return c.numeroCuenta === numero; })[0]; }",
                  "pm.test('Reporte de Marianela Montalvo con sus 2 cuentas', function () {",
                  "    pm.expect(json.cliente.nombre).to.eql('Marianela Montalvo');",
                  "    pm.expect(json.cuentas.length).to.eql(2);",
                  "});",
                  "pm.test('225487 CORRIENTE: 100 → 700 con un depósito de 600', function () {",
                  "    var c = cuenta('225487');",
                  "    pm.expect(c.saldoInicial).to.eql(100);",
                  "    pm.expect(c.saldoDisponible).to.eql(700);",
                  "    pm.expect(c.totalCreditos).to.eql(600);",
                  "    pm.expect(c.movimientos[0].tipoMovimiento).to.eql('DEPOSITO');",
                  "    pm.expect(c.movimientos[0].valor).to.eql(600);",
                  "});",
                  "pm.test('496825 AHORROS: 540 → 0 con un retiro de 540', function () {",
                  "    var c = cuenta('496825');",
                  "    pm.expect(c.saldoInicial).to.eql(540);",
                  "    pm.expect(c.saldoDisponible).to.eql(0);",
                  "    pm.expect(c.totalDebitos).to.eql(-540);",
                  "    pm.expect(c.movimientos[0].tipoMovimiento).to.eql('RETIRO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "❌ Rango de fechas invertido → 400",
